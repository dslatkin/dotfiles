{{ $is_windows := eq .chezmoi.os "windows" -}}
{{ $is_mac := eq .chezmoi.os "darwin" -}}
{{ $is_linux := eq .chezmoi.os "linux" -}}
{{ $is_pop_os := false -}}
{{ $is_ubuntu := false -}}
{{ $is_debian := false -}}
{{ $is_dev_container := ne (env "REMOTE_CONTAINERS") "" -}}
{{ $is_codespaces := ne (env "CODESPACES") "" -}}
{{ $is_container := or $is_dev_container $is_codespaces -}}
{{ if not (eq .chezmoi.os "darwin") -}}
    {{ $is_pop_os = eq .chezmoi.osRelease.id "pop" -}}
    {{ $is_ubuntu = eq .chezmoi.osRelease.id "ubuntu" -}}
    {{ $is_debian = eq .chezmoi.osRelease.id "debian" -}}
    {{ if hasKey .chezmoi.osRelease "idLike" -}}
        {{ $is_pop_os = regexMatch "\\bpop\\b" .chezmoi.osRelease.idLike -}}
        {{ $is_ubuntu = regexMatch "\\bubuntu\\b" .chezmoi.osRelease.idLike -}}
        {{ $is_debian = regexMatch "\\bdebian\\b" .chezmoi.osRelease.idLike -}}
    {{ end -}}
{{ end -}}

# In Codespaces, we don't get to choose the directory our dotfiles are cloned
# to, so we instead pass it manually during `chezmoi init` and persist it in
# config for future invocations.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[edit]
command = "code"
args = "--wait"

[data]
name = "Daniel Slatkin"
is_windows = {{ $is_windows }}
is_mac = {{ $is_mac }}
is_linux = {{ $is_linux }}
is_pop_os = {{ $is_pop_os }}
is_ubuntu = {{ $is_ubuntu }}
is_debian = {{ $is_debian }}
is_container = {{ $is_container }}

{{ writeToStdout "💬 Config file generated at " .chezmoi.configFile "\n" -}}
