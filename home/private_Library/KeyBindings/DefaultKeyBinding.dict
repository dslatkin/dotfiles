{
    /*
    Fixes shortcut-induced beeping for some Electron-based apps. For example, in
    VS Code this fixes Ctrl + Cmd + Up|Left|Right which I bind to adjust
    terminal and editor sizes.

    Applying this file requires restarting macOS to take effect.

    Sources:

    - https://gist.github.com/trusktr/1e5e516df4e8032cbc3d
    - https://developer.apple.com/library/archive/documentation/Cocoa/Conceptual/EventOverview/TextDefaultsBindings/TextDefaultsBindings.html
    - https://github.com/electron/electron/issues/2617#issuecomment-571447707
    */
    "^@\UF701" = "noop:";
    "^@\UF702" = "noop:";
    "^@\UF703" = "noop:";
}
